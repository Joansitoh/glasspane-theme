X-KDE-PluginInfo-Name=Glasspane
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-Website=https://github.com/Joansitoh/glasspane-theme
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=GPL-3.0
X-KDE-PluginInfo-EnabledByDefault=true

[ContrastEffect]
enabled=false
contrast=0.2
intensity=0.4
saturation=1.7

[AdaptiveTransparency]
enabled=true
